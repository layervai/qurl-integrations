{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    // The Teams/AWS SDK declaration graphs currently contain incompatible
    // transitive declarations; keep application type checking strict while
    // avoiding failures originating solely inside node_modules. This does
    // reduce validation of consumed SDK declarations; review SDK upgrades in
    // CI and remove this exception when their declaration graphs are fixed.
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
