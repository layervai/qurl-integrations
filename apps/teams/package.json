{
  "name": "@layervai/qurl-teams-oauth-core",
  "version": "0.0.0",
  "private": true,
  "description": "Pure OAuth security core for the future qURL™ Microsoft Teams integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests eslint.config.js --max-warnings 0",
    "test": "vitest run --coverage.enabled=false"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
