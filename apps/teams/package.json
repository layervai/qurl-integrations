{
  "name": "@layervai/qurl-teams-oauth-core",
  "version": "0.0.0",
  "private": true,
  "description": "qURL™ Microsoft Teams Bot and OAuth integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "qurl-teams": "dist/server.js"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests eslint.config.js --max-warnings 0",
    "test": "vitest run --coverage.enabled=false --config vitest.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.967.0",
    "@aws-sdk/client-kms": "^3.967.0",
    "@aws-sdk/lib-dynamodb": "^3.967.0",
    "@microsoft/teams.api": "^2.0.15",
    "@microsoft/teams.apps": "^2.0.15",
    "@microsoft/teams.common": "^2.0.15",
    "express": "^5.1.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "eslint": "^10.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
