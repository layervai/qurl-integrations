{
  "root": true,
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-prototype-builtins": "error",
    "no-case-declarations": "error",
    "eqeqeq": ["error", "smart"],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["src/**/*.js"],
      "excludedFiles": ["src/qurl.js"],
      "rules": {
        "no-restricted-syntax": ["error",
          {
            "selector": "ObjectPattern > Property[key.name='revokeResource'], MemberExpression[property.name='revokeResource'], MemberExpression[property.value='revokeResource']",
            "message": "Bot code must revoke children (connector.revokeMintedLinks); whole-resource revokeResource misses watermarked children and breaks sends sharing a deduplicated parent. It is kept for scripts/loadtest-standalone.js only."
          }
        ]
      }
    },
    {
      "files": ["src/logger.js"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["scripts/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
